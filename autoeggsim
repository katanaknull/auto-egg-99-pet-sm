-- Basit Remote Spy Mantığı
local function hookRemotes()
    local gmt = getrawmetatable(game)
    local oldNamecall = gmt.__namecall
    setreadonly(gmt, false)

    gmt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Sadece RemoteEvent ve RemoteFunction çağrılarını yakala
        if method == "FireServer" or method == "InvokeServer" then
            print("---------------------------------")
            print("Yakalama Zamanı: " .. os.date("%H:%M:%S"))
            print("Remote Yolu: " .. self:GetFullName())
            print("Metot: " .. method)
            
            -- Gönderilen verileri (argümanları) tek tek yazdır
            for i, v in pairs(args) do
                print("Argüman [" .. i .. "]: " .. tostring(v) .. " (" .. type(v) .. ")")
            end
            print("---------------------------------")
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(gmt, true)
    print("Loyal Spy Aktif: Tüm trafik F9 konsolunda!")
end

-- Çalıştır
hookRemotes()
