-- HUB AYARLARI (Önceki GUI koduna ek olarak)
local autoFarm = false

-- En Yakın Altın/Elmasları Bulan Fonksiyon
local function getNearestCoin()
    local nearest = nil
    local minDistance = math.huge
    local playerPos = game.Players.LocalPlayer.Character.HumanoidRootPart.Position

    -- PS99'da paralar genellikle 'Coins' klasöründe tutulur
    local coinsFolder = workspace:FindFirstChild("__THINGS"):FindFirstChild("Coins")
    
    if coinsFolder then
        for _, coin in pairs(coinsFolder:GetChildren()) do
            if coin:IsA("BasePart") then
                local dist = (coin.Position - playerPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearest = coin
                end
            end
        end
    end
    return nearest
end

-- Auto Farm Döngüsü
local function startFarm()
    while autoFarm do
        local target = getNearestCoin()
        if target then
            -- Karakteri paraya ışınlamak yerine paket gönderiyoruz (Daha güvenli)
            local network = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
            if network and network:FindFirstChild("Coins_Collect") then
                network.Coins_Collect:FireServer(target.Name)
            end
        end
        task.wait(0.1) -- Hızlı toplama için düşük bekleme süresi
    end
end

-- GUI'ye Yeni Buton Ekleme (Örnek)
local FarmButton = Instance.new("TextButton")
FarmButton.Parent = MainFrame -- Önceki kodundaki ana panel
FarmButton.Position = UDim2.new(0.1, 0, 0.7, 0)
FarmButton.Size = UDim2.new(0.8, 0, 0, 30)
FarmButton.Text = "Auto Farm: KAPALI"
FarmButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)

FarmButton.MouseButton1Click:Connect(function()
    autoFarm = not autoFarm
    if autoFarm then
        FarmButton.Text = "Auto Farm: AÇIK"
        FarmButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        task.spawn(startFarm)
    else
        FarmButton.Text = "Auto Farm: KAPALI"
        FarmButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    end
end)
