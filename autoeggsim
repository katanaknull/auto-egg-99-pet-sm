-- FANTASY WORLD EVENT SCRIPT
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Önceki arayüzleri temizle
if CoreGui:FindFirstChild("FantasyHub") then
    CoreGui.FantasyHub:Destroy()
end

-- Arayüz Oluşturma
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FantasyHub"
ScreenGui.Parent = CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 250, 0, 200)
MainFrame.Position = UDim2.new(0.5, -125, 0.4, -100)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 0, 50) -- Fantezi Dünyası Teması (Mor)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

-- Kenarları yuvarla
local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 10)
Corner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "🍄 FANTASY HUB 🔮"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundColor3 = Color3.fromRGB(60, 20, 100)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18
Title.Parent = MainFrame

-- Buton Oluşturucu Fonksiyon
local function createButton(name, pos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = pos
    btn.Text = name
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansSemibold
    btn.TextSize = 16
    btn.Parent = MainFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    return btn
end

-- Butonlar
local autoTrial = createButton("Auto Time Trial: KAPALI", UDim2.new(0.05, 0, 0.3, 0), Color3.fromRGB(150, 0, 0))
local autoCombine = createButton("Auto Combine: KAPALI", UDim2.new(0.05, 0, 0.6, 0), Color3.fromRGB(150, 0, 0))

-- Değişkenler
local trialActive = false
local combineActive = false

-- FONKSİYON 1: Auto Time Trial
autoTrial.MouseButton1Click:Connect(function()
    trialActive = not trialActive
    if trialActive then
        autoTrial.Text = "Auto Time Trial: AÇIK"
        autoTrial.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while trialActive do
                -- Fantasy World'deki Time Trial Remote'u (Tahmini)
                local net = ReplicatedStorage:FindFirstChild("Network")
                if net then
                    -- Bu kısım RemoteSpy ile bulacağın isme göre güncellenmeli
                    pcall(function() net.TimeTrial_Start:InvokeServer() end)
                end
                task.wait(1)
            end
        end)
    else
        autoTrial.Text = "Auto Time Trial: KAPALI"
        autoTrial.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    end
end)

-- FONKSİYON 2: Auto Combine (Otomatik Birleştirme)
autoCombine.MouseButton1Click:Connect(function()
    combineActive = not combineActive
    if combineActive then
        autoCombine.Text = "Auto Combine: AÇIK"
        autoCombine.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while combineActive do
                local net = ReplicatedStorage:FindFirstChild("Network")
                if net then
                    -- Combine (Pet birleştirme) Remote'u
                    pcall(function() net.Pets_CombineAll:InvokeServer() end)
                end
                task.wait(5)
            end
        end)
    else
        autoCombine.Text = "Auto Combine: KAPALI"
        autoCombine.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    end
end)

print("Fantasy Hub Yuklendi!")
